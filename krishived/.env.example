# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Disease detection model (ResNet50) ---
# Your inference service. See README "ML model contract" for the expected
# request/response shape. Works with FastAPI/Flask, a Supabase Edge Function,
# or any HTTPS endpoint that follows the contract.
VITE_ML_API_URL=https://your-ml-service.example.com/api/predict
VITE_ML_API_KEY=

# --- Weather ---
# Any provider works (OpenWeather, Tomorrow.io, IMD-backed proxy, etc.)
# as long as it returns the fields mapped in src/lib/api.js -> getWeather()
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
VITE_WEATHER_API_KEY=

# --- App ---
# Comma separated list, first is default. Used by the language switcher.
VITE_SUPPORTED_LANGUAGES=en,hi,mr,pa

# --- Gemini AI (chatbot after crop scan) ---
# Get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key

# --- Bhashini / ULCA (voice input, voice output, UI translation) ---
# Register at https://bhashini.gov.in/ulca/user/register
# Dashboard -> API Keys -> copy userId and ulcaApiKey
VITE_BHASHINI_USER_ID=your_bhashini_user_id
VITE_BHASHINI_API_KEY=your_bhashini_ulca_api_key
